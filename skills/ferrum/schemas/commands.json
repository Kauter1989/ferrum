{
  "study scan": {
    "description": "Lists the series in files and folders: pseudonymised id, format, modality, size, description.",
    "parameters": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "a DICOM folder or file, or a NIfTI file"
          },
          "minItems": 1
        }
      },
      "required": [
        "paths"
      ],
      "additionalProperties": false
    }
  },
  "study open": {
    "description": "Opens a series into a workspace (created if needed; the source files are hashed) and describes it.",
    "parameters": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "workspace directory; relative paths go below the operator's workspace root"
        },
        "path": {
          "type": "string",
          "description": "DICOM folder or NIfTI file"
        },
        "series": {
          "type": "string",
          "description": "series from study scan, when the source holds several"
        }
      },
      "required": [
        "workspace",
        "path"
      ],
      "additionalProperties": false
    }
  },
  "study info": {
    "description": "Describes the open study: size, spacing, patient geometry, value unit, window presets, annotation and segment counts.",
    "parameters": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "workspace directory; relative paths go below the operator's workspace root"
        }
      },
      "required": [
        "workspace"
      ],
      "additionalProperties": false
    }
  },
  "view slice": {
    "description": "Renders one slice to a PNG with a sidecar mapping pixels to voxels and patient mm. Look with images; take numbers from probe, stats and measure.",
    "parameters": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "workspace directory; relative paths go below the operator's workspace root"
        },
        "plane": {
          "type": "string",
          "enum": [
            "axial",
            "coronal",
            "sagittal"
          ],
          "description": "slice orientation"
        },
        "slice_number": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based slice number"
        },
        "at": {
          "description": "the slice through this point (instead of slice_number)",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "voxel": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "0-based voxel (i, j, k) of the canonical LPS grid; integers are voxel centres"
                }
              },
              "required": [
                "voxel"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "patient_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "LPS patient millimetres"
                }
              },
              "required": [
                "patient_mm"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "render": {
                  "type": "string",
                  "pattern": "^r-[0-9]+$",
                  "description": "id of an earlier render"
                },
                "pixel": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "pixel (x, y) of that render; pixel centres lie at +0.5"
                }
              },
              "required": [
                "render",
                "pixel"
              ],
              "additionalProperties": false
            }
          ]
        },
        "window": {
          "description": "window preset or explicit window (default: the series' own)",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "full_range",
                "brain",
                "soft_tissue",
                "lung",
                "bone"
              ]
            },
            {
              "type": "object",
              "properties": {
                "center": {
                  "type": "number",
                  "description": "window centre"
                },
                "width": {
                  "type": "number",
                  "description": "window width"
                }
              },
              "required": [
                "center",
                "width"
              ],
              "additionalProperties": false
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 16,
          "description": "largest image side in pixels (capped by the operator)"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "segments"
            ]
          },
          "description": "drawn on top: segment outlines"
        }
      },
      "required": [
        "workspace",
        "plane"
      ],
      "additionalProperties": false
    }
  },
  "view montage": {
    "description": "Renders several slices of one plane as a labelled grid (PNG + sidecar with a mapping per tile). Use it to find where something is, then view slice for detail.",
    "parameters": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "workspace directory; relative paths go below the operator's workspace root"
        },
        "plane": {
          "type": "string",
          "enum": [
            "axial",
            "coronal",
            "sagittal"
          ],
          "description": "slice orientation"
        },
        "from": {
          "type": "integer",
          "minimum": 1,
          "description": "first slice number (default 1)"
        },
        "to": {
          "type": "integer",
          "minimum": 1,
          "description": "last slice number (default: the last)"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "description": "every n-th slice (default: at most 16 tiles)"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "description": "tiles per row (default: a square grid)"
        },
        "window": {
          "description": "window preset or explicit window (default: the series' own)",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "full_range",
                "brain",
                "soft_tissue",
                "lung",
                "bone"
              ]
            },
            {
              "type": "object",
              "properties": {
                "center": {
                  "type": "number",
                  "description": "window centre"
                },
                "width": {
                  "type": "number",
                  "description": "window width"
                }
              },
              "required": [
                "center",
                "width"
              ],
              "additionalProperties": false
            }
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 16,
          "description": "largest image side in pixels (capped by the operator)"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "segments"
            ]
          },
          "description": "drawn on top: segment outlines"
        }
      },
      "required": [
        "workspace",
        "plane"
      ],
      "additionalProperties": false
    }
  },
