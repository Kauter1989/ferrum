  "view volume": {
    "description": "Renders the volume in 3D on the CPU from a standard viewpoint (PNG). Shows shape and context; its pixels do not map to voxels, so measure on slices.",
    "parameters": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "workspace directory; relative paths go below the operator's workspace root"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mip",
            "isosurface",
            "transfer_function"
          ],
          "description": "maximum intensity projection (default), shaded isosurface at threshold, or a CT transfer-function preset"
        },
        "threshold": {
          "type": "number",
          "description": "isosurface value, e.g. 300 for bone in HU"
        },
        "preset": {
          "type": "string",
          "enum": [
            "soft_tissue_bone",
            "lung_vessels",
            "bone"
          ],
          "description": "CT transfer-function preset (mode transfer_function)"
        },
        "view": {
          "type": "string",
          "enum": [
            "anterior",
            "posterior",
            "left",
            "right",
            "superior",
            "inferior"
          ],
          "description": "viewpoint (default anterior)"
        },
        "size": {
          "type": "integer",
          "minimum": 16,
          "description": "image side in pixels (default 512, capped by the operator)"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "segments"
            ]
          },
          "description": "drawn on top: segment outlines"
        }
      },
      "required": [
        "workspace"
      ],
      "additionalProperties": false
    }
  },
